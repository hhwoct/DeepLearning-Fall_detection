# ================== 检查XML结构 ==================
def inspect_xml(xmls_dir):
    """检查XML文件结构"""
    xmls_path = Path(xmls_dir)
    xml_files = list(xmls_path.glob('*.xml'))
    
    if len(xml_files) == 0:
        print(f"警告: {xmls_dir} 中没有XML文件")
        return
    
    print(f"\n{'='*60}")
    print(f"XML文件结构检查 (前3个):")
    print(f"{'='*60}")
    
    for i, xml_file in enumerate(xml_files[:3]):
        print(f"\n文件 {i+1}: {xml_file.name}")
        tree = ET.parse(xml_file)
        root = tree.getroot()
        print(f"根节点: <{root.tag}>")
        
        # 检查是否有摔倒的人
        has_down = False
        person_count = 0
        for obj in root.findall('object'):
            name_elem = obj.find('name')
            if name_elem is not None:
                name = name_elem.text.strip().lower()
                if name in ['down', 'fall', 'fallen']:
                    has_down = True
                elif name == 'person':
                    person_count += 1
        
        print(f"  摔倒者(down): {'是' if has_down else '否'}")
        print(f"  正常者(person): {person_count}个")

# ================== 数据集类 ==================
class FallDataset(Dataset):
    """摔倒检测数据集"""
    
    def __init__(self, images_dir, xmls_dir, transform=None, img_size=224):
        self.images_dir = Path(images_dir)
        self.xmls_dir = Path(xmls_dir)
        self.transform = transform
        self.img_size = img_size
        
        self.image_files = []
        for ext in ['*.png', '*.jpg', '*.jpeg']:
            for f in self.images_dir.glob(ext):
                try:
                    with Image.open(f) as img:
                        img.verify()
                    self.image_files.append(f)
                except Exception:
                    print(f"跳过损坏图像: {f.name}")
        
        self.image_files = sorted(self.image_files)
        print(f"加载 {len(self.image_files)} 张图像")
    
    def parse_xml(self, xml_path):
        """解析XML文件 - 正确读取VOC格式的 <object><name> 标签"""
        try:
            tree = ET.parse(xml_path)
            root = tree.getroot()
            
            label = 0  # 默认正常
            keypoints = np.zeros((17, 3), dtype=np.float32)
            
            # 遍历所有 <object>，找 <name>down</name>
            for obj in root.findall('object'):
                name_elem = obj.find('name')
                if name_elem is not None and name_elem.text:
                    name = name_elem.text.strip().lower()
                    if name in ['down', 'fall', 'fallen']:
                        label = 1
                        break  # 只要有一个摔倒的人，整张图就算摔倒
            
            return {'label': label, 'keypoints': keypoints}
            
        except Exception as e:
            print(f"解析XML出错 {xml_path}: {e}")
            return {'label': 0, 'keypoints': np.zeros((17, 3), dtype=np.float32)}
    
    def __len__(self):
        return len(self.image_files)
    
    def __getitem__(self, idx):
        img_path = self.image_files[idx]
        
        try:
            image = Image.open(img_path).convert('RGB')
        except Exception:
            image = Image.new('RGB', (self.img_size, self.img_size))
        
        # 加载XML
        xml_path = self.xmls_dir / f"{img_path.stem}.xml"
        if xml_path.exists():
            ann = self.parse_xml(xml_path)
        else:
            ann = {'label': 0, 'keypoints': np.zeros((17, 3), dtype=np.float32)}
        
        # 关键点（当前为零向量）
        keypoints = ann['keypoints'].copy()
        
        # 图像变换
        if self.transform:
            image = self.transform(image)
        else:
            image = transforms.Compose([
                transforms.Resize((self.img_size, self.img_size)),
                transforms.ToTensor(),
                transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
            ])(image)
        
        return {
            'image': image,
            'keypoints': torch.tensor(keypoints[:, :2].flatten(), dtype=torch.float32),
            'visibility': torch.tensor(keypoints[:, 2], dtype=torch.float32),
            'label': torch.tensor(ann['label'], dtype=torch.long)
        }

# ================== 模型 ==================
class FallDetectionModel(nn.Module):
    """摔倒检测模型"""
    
    def __init__(self, num_keypoints=17, num_classes=2):
        super().__init__()
        
        self.backbone = models.mobilenet_v3_large(weights=models.MobileNet_V3_Large_Weights.IMAGENET1K_V1)
        backbone_dim = 960
        self.backbone.classifier = nn.Identity()
        
        self.kp_encoder = nn.Sequential(
            nn.Linear(num_keypoints * 2, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(inplace=True),
            nn.Dropout(0.2),
            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.ReLU(inplace=True),
            nn.Dropout(0.2),
            nn.Linear(128, 64)
        )
        
        self.classifier = nn.Sequential(
            nn.Linear(backbone_dim + 64, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(inplace=True),
            nn.Dropout(0.3),
            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.ReLU(inplace=True),
            nn.Dropout(0.3),
            nn.Linear(128, num_classes)
        )
    
    def forward(self, image, keypoints, visibility=None):
        img_feat = self.backbone(image)
        kp_feat = self.kp_encoder(keypoints)
        combined = torch.cat([img_feat, kp_feat], dim=1)
        return self.classifier(combined)

# ================== 训练器 ==================
class Trainer:
    def __init__(self, model, config):
        self.model = model.to(config.DEVICE)
        self.config = config
        
        self.criterion = nn.CrossEntropyLoss()
        self.optimizer = optim.AdamW(model.parameters(), lr=config.LEARNING_RATE, weight_decay=1e-4)
        self.scheduler = optim.lr_scheduler.ReduceLROnPlateau(
            self.optimizer, mode='min', factor=0.5, patience=5
        )
        
        self.history = {'train_loss': [], 'train_acc': [], 'val_loss': [], 'val_acc': []}
    
    def train_epoch(self, loader):
        self.model.train()
        total_loss, correct, total = 0, 0, 0
        
        pbar = tqdm(loader, desc='Training')
        for batch in pbar:
            images = batch['image'].to(self.config.DEVICE)
            keypoints = batch['keypoints'].to(self.config.DEVICE)
            labels = batch['label'].to(self.config.DEVICE)
            
            self.optimizer.zero_grad()
            outputs = self.model(images, keypoints)
            loss = self.criterion(outputs, labels)
            loss.backward()
            self.optimizer.step()
            
            total_loss += loss.item()
            _, pred = outputs.max(1)
            total += labels.size(0)
            correct += pred.eq(labels).sum().item()
            
            pbar.set_postfix({'Loss': f'{loss.item():.4f}', 'Acc': f'{100.*correct/total:.2f}%'})
        
        return total_loss / len(loader), 100. * correct / total
    
    def validate(self, loader):
        self.model.eval()
        total_loss, correct, total = 0, 0, 0
        all_preds, all_labels = [], []
        
        with torch.no_grad():
            for batch in tqdm(loader, desc='Validating'):
                images = batch['image'].to(self.config.DEVICE)
                keypoints = batch['keypoints'].to(self.config.DEVICE)
                labels = batch['label'].to(self.config.DEVICE)
                
                outputs = self.model(images, keypoints)
                loss = self.criterion(outputs, labels)
                
                total_loss += loss.item()
                _, pred = outputs.max(1)
                total += labels.size(0)
                correct += pred.eq(labels).sum().item()
                
                all_preds.extend(pred.cpu().numpy())
                all_labels.extend(labels.cpu().numpy())
        
        return total_loss / len(loader), 100. * correct / total, all_preds, all_labels
    
    def train(self, train_loader, val_loader, class_weights=None):
        if class_weights:
            self.criterion = nn.CrossEntropyLoss(
                weight=torch.FloatTensor(class_weights).to(self.config.DEVICE)
            )
        
        print(f"\n{'='*60}")
        print(f"🚀 开始训练")
        print(f"设备: {self.config.DEVICE}")
        print(f"{'='*60}\n")
        
        best_acc = 0
        patience = 0
        
        for epoch in range(self.config.EPOCHS):
            print(f'\nEpoch {epoch+1}/{self.config.EPOCHS}')
            
            train_loss, train_acc = self.train_epoch(train_loader)
            val_loss, val_acc, _, _ = self.validate(val_loader)
            
            self.scheduler.step(val_loss)
            
            self.history['train_loss'].append(train_loss)
            self.history['train_acc'].append(train_acc)
            self.history['val_loss'].append(val_loss)
            self.history['val_acc'].append(val_acc)
            
            print(f'Train Loss: {train_loss:.4f} | Acc: {train_acc:.2f}%')
            print(f'Val Loss: {val_loss:.4f} | Acc: {val_acc:.2f}%')
            
            if val_acc > best_acc:
                best_acc = val_acc
                torch.save({
                    'model_state_dict': self.model.state_dict(),
                    'val_acc': val_acc
                }, self.config.MODEL_SAVE_PATH)
                print(f'✓ 保存最佳模型 (Acc: {val_acc:.2f}%)')
                patience = 0
            else:
                patience += 1
                if patience >= 10:
                    print(f'早停! 最佳准确率: {best_acc:.2f}%')
                    break
        
        print(f'\n✅ 训练完成! 最佳准确率: {best_acc:.2f}%')
        return self.history

# ================== 工具函数 ==================
def get_transforms(img_size=224, is_train=True):
    if is_train:
        return transforms.Compose([
            transforms.Resize((img_size, img_size)),
            transforms.RandomHorizontalFlip(p=0.5),
            transforms.RandomRotation(10),
            transforms.ColorJitter(brightness=0.2, contrast=0.2),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
        ])
    return transforms.Compose([
        transforms.Resize((img_size, img_size)),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ])

def plot_results(history):
    fig, axes = plt.subplots(1, 2, figsize=(12, 4))
    
    axes[0].plot(history['train_loss'], label='Train')
    axes[0].plot(history['val_loss'], label='Val')
    axes[0].set_title('Loss')
    axes[0].legend()
    axes[0].grid(True, alpha=0.3)
    
    axes[1].plot(history['train_acc'], label='Train')
    axes[1].plot(history['val_acc'], label='Val')
    axes[1].set_title('Accuracy (%)')
    axes[1].legend()
    axes[1].grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig('logs/training_history.png', dpi=150)
    plt.show(block=False)

def safe_classification_report(y_true, y_pred, target_names=None):
    """安全的分类报告"""
    unique_labels = np.unique(np.concatenate([y_true, y_pred]))
    
    if len(unique_labels) == 1:
        label = unique_labels[0]
        label_name = target_names[label] if target_names else str(label)
        total = len(y_true)
        correct = sum(1 for t, p in zip(y_true, y_pred) if t == p)
        acc = correct / total if total > 0 else 0
        
        print(f"\n⚠️ 验证集只包含一个类别: {label_name}")
        print(f"准确率: {acc:.2%} ({correct}/{total})")
        print("提示: 请检查数据集划分，确保训练集和验证集都包含'正常'和'摔倒'两类样本")
    else:
        print(classification_report(y_true, y_pred, target_names=target_names))

# ================== 推理函数 ==================
class FallDetector:
    """摔倒检测推理器"""
    
    def __init__(self, model_path, config=None):
        self.config = config or Config()
        self.device = self.config.DEVICE
        
        self.model = FallDetectionModel()
        checkpoint = torch.load(model_path, map_location=self.device, weights_only=True)
        self.model.load_state_dict(checkpoint['model_state_dict'])
        self.model.to(self.device)
        self.model.eval()
        
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
        ])
        
        print(f"✅ 模型加载成功 (验证准确率: {checkpoint.get('val_acc', 0.0):.2f}%)")
    
    def predict_image(self, image_path):
        """预测单张图像"""
        image = Image.open(image_path).convert('RGB')
        image_tensor = self.transform(image).unsqueeze(0).to(self.device)
        
        # 关键点暂时为零向量
        keypoints = torch.zeros(1, 34).to(self.device)
        
        with torch.no_grad():
            outputs = self.model(image_tensor, keypoints)
            probabilities = torch.softmax(outputs, dim=1)
            predicted_class = torch.argmax(outputs, dim=1).item()
        
        class_names = ['正常', '摔倒']
        result = {
            'class': class_names[predicted_class],
            'class_id': predicted_class,
            'confidence': probabilities[0][predicted_class].item(),
            'probabilities': {
                '正常': probabilities[0][0].item(),
                '摔倒': probabilities[0][1].item()
            }
        }
        
        return result


# ================== 主函数 ==================
def main():
    config = Config()
    
    # 检查XML结构
    inspect_xml(config.TRAIN_XMLS)
    
    # 创建数据集
    print("\n创建数据集...")
    train_ds = FallDataset(config.TRAIN_IMAGES, config.TRAIN_XMLS, get_transforms(config.IMG_SIZE, True))
    val_ds = FallDataset(config.VAL_IMAGES, config.VAL_XMLS, get_transforms(config.IMG_SIZE, False))
    
    # 分析标签
    train_labels = [int(train_ds[i]['label']) for i in range(len(train_ds))]
    val_labels = [int(val_ds[i]['label']) for i in range(len(val_ds))]
    
    train_cnt = Counter(train_labels)
    val_cnt = Counter(val_labels)
    
    print(f"\n训练集分布: 正常={train_cnt.get(0,0)}, 摔倒={train_cnt.get(1,0)}")
    print(f"验证集分布: 正常={val_cnt.get(0,0)}, 摔倒={val_cnt.get(1,0)}")
    
    # 检查是否只有单一类别
    if len(val_cnt) < 2:
        print("\n⚠️ 警告：验证集中只有一个类别！")
        print("这会导致准确率虚高。请检查数据集划分。")
    
    # 类别权重
    n = len(train_labels)
    weights = [n / (2 * max(train_cnt.get(i, 1), 1)) for i in range(2)]
    print(f"类别权重: 正常={weights[0]:.2f}, 摔倒={weights[1]:.2f}")
    
    # DataLoader
    train_loader = DataLoader(train_ds, batch_size=config.BATCH_SIZE, shuffle=True, num_workers=0, drop_last=True)
    val_loader = DataLoader(val_ds, batch_size=config.BATCH_SIZE, shuffle=False, num_workers=0)
    
    # 模型
    print("\n初始化模型...")
    model = FallDetectionModel()
    print(f"参数量: {sum(p.numel() for p in model.parameters()):,}")
    
    # 训练
    trainer = Trainer(model, config)
    history = trainer.train(train_loader, val_loader, weights)
    
    # 可视化
    plot_results(history)
    
    # 最终评估
    print("\n" + "="*60)
    print("最终评估")
    print("="*60)
    
    checkpoint = torch.load(config.MODEL_SAVE_PATH, map_location=config.DEVICE, weights_only=True)
    model.load_state_dict(checkpoint['model_state_dict'])
    model.eval()
    
    val_loss, val_acc, preds, labels = trainer.validate(val_loader)
    print(f'\n验证准确率: {val_acc:.2f}%')
    
    # 安全打印分类报告
    safe_classification_report(labels, preds, target_names=['正常', '摔倒'])
    
    # 混淆矩阵
    if len(set(labels)) > 1:
        cm = confusion_matrix(labels, preds)
        plt.figure(figsize=(6, 5))
        sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', 
                   xticklabels=['正常', '摔倒'], yticklabels=['正常', '摔倒'])
        plt.title('Confusion Matrix')
        plt.tight_layout()
        plt.savefig('logs/confusion_matrix.png', dpi=150)
        plt.show(block=False)
    else:
        print("\n⚠️ 无法生成混淆矩阵（验证集只有一个类别）")
    
    # ================== 推理演示 ==================
    print("\n" + "="*60)
    print("推理演示")
    print("="*60)
    
    detector = FallDetector(config.MODEL_SAVE_PATH, config)
    
    # 测试几张图像
    val_images = list(Path(config.VAL_IMAGES).glob('*.jpg'))[:5]
    if len(val_images) == 0:
        val_images = list(Path(config.VAL_IMAGES).glob('*.png'))[:5]
    
    if val_images:
        print(f"\n测试 {len(val_images)} 张验证集图像:")
        for img_path in val_images:
            result = detector.predict_image(img_path)
            print(f"  {img_path.name}: {result['class']} "
                  f"(置信度: {result['confidence']:.2%})")
    
    print(f"\n✅ 完成！")
    print(f"模型保存位置: {config.MODEL_SAVE_PATH}")
    print(f"训练曲线: logs/training_history.png")

if __name__ == '__main__':
    main()