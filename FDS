    DATA_ROOT = 'dataset'
    TRAIN_IMAGES = os.path.join(DATA_ROOT, 'train/images')
    TRAIN_XMLS = os.path.join(DATA_ROOT, 'train/images')      # XML和图片在同一目录
    VAL_IMAGES = os.path.join(DATA_ROOT, 'val/images')
    VAL_XMLS = os.path.join(DATA_ROOT, 'val/images')          # XML和图片在同一目录
    
    IMG_SIZE = 224
    BATCH_SIZE = 16
    EPOCHS = 50
    LEARNING_RATE = 1e-4
    NUM_CLASSES = 2
    NUM_KEYPOINTS = 17
    
    MODEL_SAVE_PATH = 'checkpoints/fall_detection_model.pth'
    
    if torch.backends.mps.is_available():
        DEVICE = torch.device('mps')
        print("🍎 使用 Apple MPS 加速")
    elif torch.cuda.is_available():
