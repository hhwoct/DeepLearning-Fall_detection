# ================== 数据集类 ==================
class FallDataset(Dataset):
    def __init__(self, images_dir, xmls_dir, transform=None, img_size=224):
        self.images_dir = Path(images_dir)
        self.xmls_dir = Path(xmls_dir)
        self.transform = transform
        self.img_size = img_size
        
        self.image_files = []
        for ext in ['*.png', '*.jpg', '*.jpeg']:
            for f in self.images_dir.glob(ext):
                try:
                    with Image.open(f) as img:
                        img.verify()
                    self.image_files.append(f)
                except:
                    print(f"跳过损坏图像: {f.name}")
        
        self.image_files = sorted(self.image_files)
        print(f"加载 {len(self.image_files)} 张图像")
    
    def parse_xml(self, xml_path):
        try:
            tree = ET.parse(xml_path)
            root = tree.getroot()
            label = 0
            keypoints = np.zeros((17, 3), dtype=np.float32)
            
            for obj in root.findall('object'):
                name_elem = obj.find('name')
                if name_elem is not None and name_elem.text:
                    name = name_elem.text.strip().lower()
                    if name in ['down', 'fall', 'fallen']:
                        label = 1
                        break
            return {'label': label, 'keypoints': keypoints}
        except Exception as e:
            return {'label': 0, 'keypoints': np.zeros((17, 3), dtype=np.float32)}
    
    def __len__(self):
        return len(self.image_files)
    
    def __getitem__(self, idx):
        img_path = self.image_files[idx]
        try:
            image = Image.open(img_path).convert('RGB')
        except:
            image = Image.new('RGB', (self.img_size, self.img_size))
        
        xml_path = self.xmls_dir / f"{img_path.stem}.xml"
        if xml_path.exists():
            ann = self.parse_xml(xml_path)
        else:
            ann = {'label': 0, 'keypoints': np.zeros((17, 3), dtype=np.float32)}
        
        keypoints = ann['keypoints'].copy()
        
        if self.transform:
            image = self.transform(image)
        else:
            image = transforms.Compose([
                transforms.Resize((self.img_size, self.img_size)),
                transforms.ToTensor(),
                transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
            ])(image)
        
        return {
            'image': image,
            'keypoints': torch.tensor(keypoints[:, :2].flatten(), dtype=torch.float32),
            'visibility': torch.tensor(keypoints[:, 2], dtype=torch.float32),
            'label': torch.tensor(ann['label'], dtype=torch.long)
        }


# ================== MobileNetV3 + 关键点模型 ==================
class FallDetectionModel(nn.Module):
    def __init__(self, num_keypoints=17, num_classes=2):
        super().__init__()
        self.backbone = models.mobilenet_v3_large(weights=models.MobileNet_V3_Large_Weights.IMAGENET1K_V1)
        backbone_dim = 960
        self.backbone.classifier = nn.Identity()
        
        self.kp_encoder = nn.Sequential(
            nn.Linear(num_keypoints * 2, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(inplace=True),
            nn.Dropout(0.2),
            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.ReLU(inplace=True),
            nn.Dropout(0.2),
            nn.Linear(128, 64)
        )
        
        self.classifier = nn.Sequential(
            nn.Linear(backbone_dim + 64, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(inplace=True),
            nn.Dropout(0.3),
            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.ReLU(inplace=True),
            nn.Dropout(0.3),
            nn.Linear(128, num_classes)
        )
    
    def forward(self, image, keypoints, visibility=None):
        img_feat = self.backbone(image)
        kp_feat = self.kp_encoder(keypoints)
        combined = torch.cat([img_feat, kp_feat], dim=1)
        return self.classifier(combined)


# ================== ResNet18 模型（对比实验） ==================
class ResNet18Model(nn.Module):
    def __init__(self, num_classes=2):
        super().__init__()
        self.backbone = models.resnet18(weights=models.ResNet18_Weights.IMAGENET1K_V1)
        in_features = self.backbone.fc.in_features
        self.backbone.fc = nn.Sequential(
            nn.Dropout(0.3),
            nn.Linear(in_features, num_classes)
        )
    
    def forward(self, image, keypoints=None, visibility=None):
        return self.backbone(image)


# ================== MobileNetV3 训练器 ==================
class MobileNetV3Trainer:
    def __init__(self, model, config):
        self.model = model.to(config.DEVICE)
        self.config = config
        self.criterion = nn.CrossEntropyLoss()
        self.optimizer = optim.AdamW(model.parameters(), lr=config.LEARNING_RATE, weight_decay=1e-4)
        self.scheduler = optim.lr_scheduler.ReduceLROnPlateau(
            self.optimizer, mode='min', factor=0.5, patience=5
        )
        self.history = {'train_loss': [], 'train_acc': [], 'val_loss': [], 'val_acc': []}
    
    def train_epoch(self, loader):
        self.model.train()
        total_loss, correct, total = 0, 0, 0
        pbar = tqdm(loader, desc='Training MobileNetV3')
        for batch in pbar:
            images = batch['image'].to(self.config.DEVICE)
            keypoints = batch['keypoints'].to(self.config.DEVICE)
            labels = batch['label'].to(self.config.DEVICE)
            
            self.optimizer.zero_grad()
            outputs = self.model(images, keypoints)
            loss = self.criterion(outputs, labels)
            loss.backward()
            self.optimizer.step()
            
            total_loss += loss.item()
            _, pred = outputs.max(1)
            total += labels.size(0)
            correct += pred.eq(labels).sum().item()
            pbar.set_postfix({'Loss': f'{loss.item():.4f}', 'Acc': f'{100.*correct/total:.2f}%'})
        return total_loss / len(loader), 100. * correct / total
    
    def validate(self, loader):
        self.model.eval()
        total_loss, correct, total = 0, 0, 0
        all_preds, all_labels = [], []
        with torch.no_grad():
            for batch in tqdm(loader, desc='Validating MobileNetV3'):
                images = batch['image'].to(self.config.DEVICE)
                keypoints = batch['keypoints'].to(self.config.DEVICE)
                labels = batch['label'].to(self.config.DEVICE)
                
                outputs = self.model(images, keypoints)
                loss = self.criterion(outputs, labels)
                
                total_loss += loss.item()
                _, pred = outputs.max(1)
                total += labels.size(0)
                correct += pred.eq(labels).sum().item()
                
                all_preds.extend(pred.cpu().numpy())
                all_labels.extend(labels.cpu().numpy())
        return total_loss / len(loader), 100. * correct / total, all_preds, all_labels
    
    def train(self, train_loader, val_loader, class_weights=None):
        if class_weights:
            self.criterion = nn.CrossEntropyLoss(
                weight=torch.FloatTensor(class_weights).to(self.config.DEVICE)
            )
        
        print(f"\n{'='*60}")
        print(f"🚀 开始训练 MobileNetV3 + 关键点分支")
        print(f"设备: {self.config.DEVICE}")
        print(f"{'='*60}\n")
        
        best_acc = 0
        patience = 0
        
        for epoch in range(self.config.EPOCHS):
            print(f'\nEpoch {epoch+1}/{self.config.EPOCHS}')
            train_loss, train_acc = self.train_epoch(train_loader)
            val_loss, val_acc, _, _ = self.validate(val_loader)
            self.scheduler.step(val_loss)
            
            self.history['train_loss'].append(train_loss)
            self.history['train_acc'].append(train_acc)
            self.history['val_loss'].append(val_loss)
            self.history['val_acc'].append(val_acc)
            
            print(f'Train Loss: {train_loss:.4f} | Acc: {train_acc:.2f}%')
            print(f'Val Loss: {val_loss:.4f} | Acc: {val_acc:.2f}%')
            
            if val_acc > best_acc:
                best_acc = val_acc
                torch.save({
                    'model_state_dict': self.model.state_dict(),
                    'val_acc': val_acc
                }, self.config.MODEL_SAVE_PATH)
                print(f'✓ 保存最佳模型 (Acc: {val_acc:.2f}%)')
                patience = 0
            else:
                patience += 1
                if patience >= 10:
                    print(f'早停! 最佳准确率: {best_acc:.2f}%')
                    break
        
        print(f'\n✅ 训练完成! 最佳准确率: {best_acc:.2f}%')
        return self.history


