def plot_confusion_matrix(labels, preds, title_prefix=""):
    if len(set(labels)) < 2:
        print(f"⚠️ {title_prefix}: 验证集只有一个类别，跳过混淆矩阵")
        return
    cm = confusion_matrix(labels, preds)
    plt.figure(figsize=(6, 5))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', 
                xticklabels=['正常', '摔倒'], yticklabels=['正常', '摔倒'])
    plt.title(f'{title_prefix} Confusion Matrix')
    plt.tight_layout()
    plt.savefig(f'logs/{title_prefix.lower().replace(" ", "_")}_cm.png', dpi=150)
    plt.show()


def plot_roc_curve(model, val_loader, config, model_name, use_keypoints=True):
    """绘制ROC曲线"""
    model.eval()
    all_probs = []
    all_labels = []
    
    with torch.no_grad():
        for batch in tqdm(val_loader, desc=f'Computing ROC for {model_name}'):
            images = batch['image'].to(config.DEVICE)
            labels = batch['label'].to(config.DEVICE)
            
            if use_keypoints:
                keypoints = batch['keypoints'].to(config.DEVICE)
                outputs = model(images, keypoints)
            else:
                outputs = model(images)
            
            probs = torch.softmax(outputs, dim=1)[:, 1]
            all_probs.extend(probs.cpu().numpy())
            all_labels.extend(labels.cpu().numpy())
    
    fpr, tpr, _ = roc_curve(all_labels, all_probs)
    roc_auc = auc(fpr, tpr)
    
    plt.figure(figsize=(8, 6))
    plt.plot(fpr, tpr, color='darkorange', lw=2, label=f'{model_name} (AUC = {roc_auc:.3f})')
    plt.plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--', label='Random (AUC = 0.5)')
    plt.xlim([0.0, 1.0])
    plt.ylim([0.0, 1.05])
    plt.xlabel('False Positive Rate')
    plt.ylabel('True Positive Rate')
    plt.title(f'ROC Curve - {model_name}')
    plt.legend(loc="lower right")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(f'logs/roc_curve_{model_name.lower().replace(" ", "_")}.png', dpi=150)
    plt.show()
    
    return roc_auc


def plot_model_comparison(results):
    """绘制模型对比柱状图"""
    names = list(results.keys())
    accs = [results[name]['acc'] for name in names]
    params = [results[name]['params'] for name in names]
    
    fig, axes = plt.subplots(1, 2, figsize=(12, 5))
    
    # 准确率对比
    bars1 = axes[0].bar(names, accs, color=['#3498db', '#e74c3c'])
    axes[0].set_ylabel('Validation Accuracy (%)')
    axes[0].set_title('Model Accuracy Comparison')
    axes[0].set_ylim(0, 100)
    for bar, acc in zip(bars1, accs):
