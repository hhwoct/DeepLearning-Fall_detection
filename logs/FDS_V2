    plt.tight_layout()
    plt.savefig('logs/model_comparison.png', dpi=150)
    plt.show()


def generate_cam_heatmaps(model, val_loader, config, model_name, use_keypoints=True, num_samples=5):
    """生成Grad-CAM热力图"""
    if not GRAD_CAM_AVAILABLE:
        print("跳过CAM热力图: 未安装pytorch-grad-cam")
        return
    
    model.eval()
    
    # 获取目标层
    if isinstance(model, ResNet18Model):
        target_layers = [model.backbone.layer4[-1]]
    else:
        target_layers = [model.backbone.features[-1]]
    
    cam = GradCAM(model=model, target_layers=target_layers)
    
    # 收集样本
    samples = []
    for batch in val_loader:
        samples.append(batch)
        if len(samples) * config.BATCH_SIZE >= num_samples:
            break
    
    mean = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1).to(config.DEVICE)
    std = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1).to(config.DEVICE)
    
    sample_idx = 0
    for batch in samples:
        images = batch['image'][:num_samples - sample_idx].to(config.DEVICE)
        labels = batch['label'][:num_samples - sample_idx].cpu().numpy()
        keypoints = batch['keypoints'][:num_samples - sample_idx].to(config.DEVICE)
        
        display_images = (images * std + mean).cpu().numpy().transpose(0, 2, 3, 1)
        display_images = np.clip(display_images, 0, 1)
        
        fig, axes = plt.subplots(min(len(images), num_samples - sample_idx), 3, 
                                 figsize=(12, 4*min(len(images), num_samples - sample_idx)))
        if len(images) == 1:
            axes = axes.reshape(1, -1)
        
        for i in range(len(images)):
            if sample_idx >= num_samples:
                break
            
            if use_keypoints:
                grayscale_cam = cam(input_tensor=images[i:i+1], targets=None)
            else:
                grayscale_cam = cam(input_tensor=images[i:i+1], targets=None)
            
            cam_image = show_cam_on_image(display_images[i], grayscale_cam[0], use_rgb=True)
            
            axes[i, 0].imshow(display_images[i])
            axes[i, 0].set_title(f'Original\nTrue: {"摔倒" if labels[i]==1 else "正常"}')
            axes[i, 0].axis('off')
            
            axes[i, 1].imshow(grayscale_cam[0], cmap='jet')
            axes[i, 1].set_title('CAM Heatmap')
            axes[i, 1].axis('off')
            
            axes[i, 2].imshow(cam_image)
            axes[i, 2].set_title('Overlay')
            axes[i, 2].axis('off')
            
            sample_idx += 1
        
        plt.tight_layout()
        plt.savefig(f'logs/cam_{model_name.lower().replace(" ", "_")}.png', dpi=150)
        plt.show()
        if sample_idx >= num_samples:
            break


# ================== 推理器 ==================
class FallDetector:
    def __init__(self, model_path, model_type='mobilenetv3', config=None):
        self.config = config or Config()
        self.device = self.config.DEVICE
        self.model_type = model_type
        
        if model_type == 'mobilenetv3':
            self.model = FallDetectionModel()
        else:
            self.model = ResNet18Model()
        
        checkpoint = torch.load(model_path, map_location=self.device)
        self.model.load_state_dict(checkpoint['model_state_dict'])
        self.model.to(self.device)
        self.model.eval()
        
        self.transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
        ])
        
        print(f"✅ {model_type.upper()} 模型加载成功 (验证准确率: {checkpoint.get('val_acc', 'N/A'):.2f}%)")
    
    def predict_image(self, image_path):
        image = Image.open(image_path).convert('RGB')
        image_tensor = self.transform(image).unsqueeze(0).to(self.device)
        
        with torch.no_grad():
            if self.model_type == 'mobilenetv3':
                keypoints = torch.zeros(1, 34).to(self.device)
                outputs = self.model(image_tensor, keypoints)
            else:
                outputs = self.model(image_tensor)
            probabilities = torch.softmax(outputs, dim=1)
            predicted_class = torch.argmax(outputs, dim=1).item()
        
        return {
            'class': '摔倒' if predicted_class == 1 else '正常',
            'class_id': predicted_class,
            'confidence': probabilities[0][predicted_class].item(),
            'probabilities': {'正常': probabilities[0][0].item(), '摔倒': probabilities[0][1].item()}
        }


# ================== 主函数 ==================
def main():
    config = Config()
    
    # 创建数据集
    print("\n创建数据集...")
    train_ds = FallDataset(config.TRAIN_IMAGES, config.TRAIN_XMLS, 
                           get_transforms(config.IMG_SIZE, True))
    val_ds = FallDataset(config.VAL_IMAGES, config.VAL_XMLS, 
                         get_transforms(config.IMG_SIZE, False))
    
    # 分析标签分布
    train_labels = [int(train_ds[i]['label']) for i in range(len(train_ds))]
    val_labels = [int(val_ds[i]['label']) for i in range(len(val_ds))]
    train_cnt = Counter(train_labels)
    val_cnt = Counter(val_labels)
    
    print(f"\n训练集分布: 正常={train_cnt.get(0,0)}, 摔倒={train_cnt.get(1,0)}")
    print(f"验证集分布: 正常={val_cnt.get(0,0)}, 摔倒={val_cnt.get(1,0)}")
    
    # 类别权重
    n = len(train_labels)
    weights = [n / (2 * max(train_cnt.get(i, 1), 1)) for i in range(2)]
    print(f"类别权重: 正常={weights[0]:.2f}, 摔倒={weights[1]:.2f}")
    
    # DataLoader
    train_loader = DataLoader(train_ds, batch_size=config.BATCH_SIZE, shuffle=True, num_workers=0, drop_last=True)
    val_loader = DataLoader(val_ds, batch_size=config.BATCH_SIZE, shuffle=False, num_workers=0)
    
    results = {}
    
    # ================== 训练 MobileNetV3 模型 ==================
    print("\n" + "="*80)
    print("📱 模型 1: MobileNetV3-Large + 关键点分支")
    print("="*80)
    
    model1 = FallDetectionModel()
    print(f"MobileNetV3 参数量: {sum(p.numel() for p in model1.parameters()):,}")
    
    trainer1 = MobileNetV3Trainer(model1, config)
    history1 = trainer1.train(train_loader, val_loader, weights)
    
    # 加载最佳模型并评估
    checkpoint1 = torch.load(config.MODEL_SAVE_PATH, map_location=config.DEVICE)
    model1.load_state_dict(checkpoint1['model_state_dict'])
    val_loss1, val_acc1, preds1, labels1 = trainer1.validate(val_loader)
    
    results['MobileNetV3'] = {
        'acc': val_acc1,
        'history': history1,
        'preds': preds1,
        'labels': labels1,
        'params': sum(p.numel() for p in model1.parameters())
    }
    
    # 绘制训练曲线
    plot_training_history(history1, "MobileNetV3")
    plot_confusion_matrix(labels1, preds1, "MobileNetV3")
    
    # 绘制ROC曲线
    roc_auc1 = plot_roc_curve(model1, val_loader, config, "MobileNetV3", use_keypoints=True)
    print(f"MobileNetV3 AUC: {roc_auc1:.3f}")
    
    # 生成CAM热力图
    if GRAD_CAM_AVAILABLE:
        generate_cam_heatmaps(model1, val_loader, config, "MobileNetV3", use_keypoints=True, num_samples=5)
    
    # ================== 训练 ResNet18 模型（对比） ==================
    print("\n" + "="*80)
    print("🔬 模型 2: ResNet18（纯图像分类 - 对比实验）")
    print("="*80)
    
    model2 = ResNet18Model()
    print(f"ResNet18 参数量: {sum(p.numel() for p in model2.parameters()):,}")
    
    trainer2 = ResNet18Trainer(model2, config)
    history2 = trainer2.train(train_loader, val_loader, weights)
    
    # 加载最佳模型并评估
    if os.path.exists(config.RESNET18_SAVE_PATH):
        checkpoint2 = torch.load(config.RESNET18_SAVE_PATH, map_location=config.DEVICE)
        model2.load_state_dict(checkpoint2['model_state_dict'])
    val_loss2, val_acc2, preds2, labels2 = trainer2.validate(val_loader)
    
    results['ResNet18'] = {
        'acc': val_acc2,
        'history': history2,
        'preds': preds2,
        'labels': labels2,
        'params': sum(p.numel() for p in model2.parameters())
    }
    
    # 绘制训练曲线
    plot_training_history(history2, "ResNet18")
    plot_confusion_matrix(labels2, preds2, "ResNet18")
    
    # 绘制ROC曲线
    roc_auc2 = plot_roc_curve(model2, val_loader, config, "ResNet18", use_keypoints=False)
    print(f"ResNet18 AUC: {roc_auc2:.3f}")
    
    # ================== 模型对比总结 ==================
    print("\n" + "="*60)
    print("📊 模型对比结果汇总")
    print("="*60)
    print(f"\n{'模型':<20} {'验证准确率':<15} {'参数量':<15} {'AUC':<10}")
    print("-" * 60)
    print(f"{'MobileNetV3':<20} {results['MobileNetV3']['acc']:.2f}%{'':<10} {results['MobileNetV3']['params']:,}   {roc_auc1:.3f}")
    print(f"{'ResNet18':<20} {results['ResNet18']['acc']:.2f}%{'':<10} {results['ResNet18']['params']:,}   {roc_auc2:.3f}")
    
    # 绘制模型对比图
    plot_model_comparison(results)
    
    # ================== 推理演示 ==================
    print("\n" + "="*60)
    print("推理演示")
    print("="*60)
    
    # 使用最佳模型进行推理
    best_model_name = max(results, key=lambda x: results[x]['acc'])
    print(f"\n使用最佳模型: {best_model_name} (准确率: {results[best_model_name]['acc']:.2f}%)")
    
    if best_model_name == 'MobileNetV3':
        detector = FallDetector(config.MODEL_SAVE_PATH, 'mobilenetv3', config)
    else:
        detector = FallDetector(config.RESNET18_SAVE_PATH, 'resnet18', config)
    
    # 测试几张验证集图像
    val_images = list(Path(config.VAL_IMAGES).glob('*.jpg'))[:5]
    if len(val_images) == 0:
        val_images = list(Path(config.VAL_IMAGES).glob('*.png'))[:5]
    
    if val_images:
        print(f"\n测试 {len(val_images)} 张验证集图像:")
        for img_path in val_images:
            result = detector.predict_image(img_path)
            print(f"  {img_path.name}: {result['class']} (置信度: {result['confidence']:.2%})")
    
    print(f"\n✅ 所有实验完成！")
    print(f"📁 模型保存位置:")
    print(f"   MobileNetV3: {config.MODEL_SAVE_PATH}")
    print(f"   ResNet18: {config.RESNET18_SAVE_PATH}")
    print(f"📁 日志和图表: logs/ 目录")


if __name__ == '__main__':
    main()